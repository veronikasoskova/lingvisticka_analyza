{
  "name": "Skinner Pipeline",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash setup.sh",
  "postStartCommand": "streamlit run app.py --server.headless true --server.port 8501 &"
}
