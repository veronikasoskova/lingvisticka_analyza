{
  "name": "Skinner Pipeline",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash setup.sh",
  "postStartCommand": "bash -lc 'cd \"${containerWorkspaceFolder}\" && streamlit run \"${containerWorkspaceFolder}/app.py\" --server.address 0.0.0.0 --server.port 8501 --server.headless true --server.baseUrlPath \"\" --server.maxUploadSize 2048 --server.maxMessageSize 2048 &'"
}
